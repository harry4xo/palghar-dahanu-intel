# Copy to .env and adjust. Every value is optional for local development.
DJANGO_DEBUG=1
# Required when DJANGO_DEBUG=0:
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# SQLite is used when this is empty. Example for Postgres:
# DATABASE_URL=postgres://pdi:password@localhost:5432/pdi
DATABASE_URL=
# Sent in the User-Agent by the crawlers (OpenStreetMap's usage policy asks for contact details).
CRAWLER_CONTACT=palghar-dahanu-intel (research database)
